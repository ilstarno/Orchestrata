  "rules": [
    {
      "id": "R01",
      "description": "Mapped pickup and delivery must both match; sequence 2 precedes 3.",
      "kind": "company"
    },
    {
      "id": "R02",
      "description": "The route mode must be among the modes allowed for the shipment.",
      "kind": "company"
    },
    {
      "id": "R03",
      "description": "The courier must be available and their assigned asset in service.",
      "kind": "company"
    },
    {
      "id": "R04",
      "description": "At pickup, shipment plus current load cannot exceed payload capacity.",
      "kind": "company"
    },
    {
      "id": "R05",
      "description": "Wait if early; both pickup and delivery service must finish by each window's end.",
      "kind": "company"
    },
    {
      "id": "R06",
      "description": "The planned route must finish by the courier's shift end.",
      "kind": "company"
    },
    {
      "id": "R07",
      "description": "Only one request per fixed route; choose feasible requests by priority, then stable request ID.",
      "kind": "company"
    },
    {
      "id": "R09",
      "description": "Operator must be qualified for the requested handling; cargo must fit the configured internal dimensions.",
      "kind": "company"
    },
    {
      "id": "R10",
      "description": "Borrowing another team’s operator requires simulated cross-team approval.",
      "kind": "company"
    },
    {
      "id": "R11",
      "description": "Missing scenario road or curb evidence holds the request for review. Sample evidence is not a permit.",
      "kind": "company"
    },
    {
      "id": "R08",
      "description": "Travel follows the already mapped OSM profile; segment durations are estimates, not live traffic.",
      "kind": "map_model"
    }
